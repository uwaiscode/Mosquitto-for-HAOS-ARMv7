#!/bin/ash
set -e

# ===== LOAD CONFIG FROM HAOS OPTIONS =====
USERNAME=$(jq -r '.mqtt_username // "neutron"' /data/options.json)
PASSWORD=$(jq -r '.mqtt_password // "neutron123"' /data/options.json)

# ===== SETUP PASSWORD FILE =====
PASSWD_DIR="/data/mosquitto"
PASSWD_FILE="${PASSWD_DIR}/passwd"

mkdir -p "$PASSWD_DIR"

# Buat/update password file hanya jika user berubah atau file belum ada
if [ ! -f "$PASSWD_FILE" ] || ! grep -q "^${USERNAME}:" "$PASSWD_FILE" 2>/dev/null; then
    echo "[setup] Generating password file for user: ${USERNAME}"
    /usr/bin/mosquitto_passwd -b -c "$PASSWD_FILE" "$USERNAME" "$PASSWORD"
    chmod 644 "$PASSWD_FILE"
    chown mosquitto:mosquitto "$PASSWD_FILE"
fi

# Validasi file bisa dibaca
if [ ! -r "$PASSWD_FILE" ]; then
    echo "[error] Password file not readable: ${PASSWD_FILE}" >&2
    exit 1
fi

echo "[mosquitto] Starting broker — MQTT:1883 | WS:9001 | User:${USERNAME}"

# ===== EXEC MOSQUITTO (foreground, sebagai user mosquitto) =====
# -u mosquitto: drop privilege setelah bind port
exec /usr/sbin/mosquitto -c /etc/mosquitto/mosquitto.conf -u mosquitto